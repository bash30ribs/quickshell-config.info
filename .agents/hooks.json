{
  "post-edit-verifier": {
    "enabled": true,
    "PostToolUse": [
      {
        "matcher": "edit_file|write_file",
        "hooks": [
          {
            "type": "command",
            "command": "./scripts/verify.sh",
            "timeout": 15
          }
        ]
      }
    ]
  },
  "ralph-loop": {
    "enabled": true,
    "Stop": [
      {
        "type": "command",
        "command": "python3 ../scripts/ralph-stop-hook.py",
        "timeout": 60
      }
    ]
  }
}
